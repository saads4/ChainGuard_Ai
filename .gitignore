# ─────────────────────────────────────────────────────────────
# ChainGuardAI — .gitignore
# ─────────────────────────────────────────────────────────────

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
MANIFEST

# ─── Virtual Environment ─────────────────────────────────────
venv/
.venv/
env/
ENV/
.env.local
.env.*.local

# ─── Environment & Secrets ───────────────────────────────────
# Keep .env.example but never commit .env
.env
*.key
*.pem
*.p12
*.pfx
root_authority_keys.json

# ─── ML Model Artifacts ──────────────────────────────────────
# Trained model files — too large for git, regenerated via ml/run_all.py
data/models/
data/processed/
data/eval_results/

# HuggingFace model cache (sentence-transformers downloads)
.cache/
~/.cache/huggingface/

# ─── Dataset Files ───────────────────────────────────────────
# Raw datasets are large; only committed configs, not CSVs/JSONLs
dataset/stage3_training/*.csv
dataset/stage3_training/*.pkl
dataset/attack_simulation/*.csv
dataset/stage2_benign/*.jsonl

# Wild attacks file (generated by ml/preprocess/attack_sim_merge.py)
dataset/attack_simulation/wild_attacks.csv

# ─── Keys & Cryptographic Material ──────────────────────────
keys/
data/keys/
data/registry/

# ─── Logs ────────────────────────────────────────────────────
logs/*.log
logs/*.jsonl
logs/check_logs.py

# ─── Testing & Coverage ──────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml
*.coveragerc

# ─── IDE & Editor ────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ─── Jupyter Notebooks ───────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Build / Distribution ────────────────────────────────────
*.spec
*.manifest
